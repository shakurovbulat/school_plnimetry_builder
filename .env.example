# Base URL of the external API, including the version prefix if required.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6.2-sol

# Optional: plaintext key file if LLM_API_KEY is not set.
# LLM_KEY_FILE=
# Read timeout in seconds (waiting for data), not the provider gateway's timeout.
# LLM_TIMEOUT=180
# LLM_MAX_TOKENS=8192
# Set to false only if the provider does not support SSE streaming.
# LLM_STREAM=true
